pipeline {
    agent any

    environment {
        IMAGE_NAME = "employee-management-api"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Inspect Jenkins Workspace') {
            steps {
                sh '''
                    echo "==============================="
                    echo "JENKINS WORKSPACE"
                    echo "==============================="

                    echo "WORKSPACE = $WORKSPACE"
                    echo "PWD = $(pwd)"

                    echo ""
                    echo "===== ROOT DIRECTORY ====="
                    ls -lah

                    echo ""
                    echo "===== APPLICATION DIRECTORY ====="
                    ls -lah application || true

                    echo ""
                    echo "===== REQUIREMENTS ====="
                    ls -lah application/requirements.txt || true

                    echo ""
                    echo "===== DOCKERFILE ====="
                    ls -lah application/Dockerfile || true

                    echo ""
                    echo "===== COMPLETE TREE ====="
                    find . -maxdepth 3
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} application
                '''
            }
        }

    }

    post {
        success {
            echo "Pipeline completed successfully."
        }

        failure {
            echo "Pipeline failed."
        }

        always {
            cleanWs()
        }
    }
}