pipeline {
    agent any

    environment {
        IMAGE_NAME = "employee-management-api"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Inspect Mounted Directory') {
            steps {
                sh '''
                docker run --rm \
                -v "$WORKSPACE/application":/app \
                -w /app \
                python:3.12-slim \
                sh -c "
                    echo 'Current directory:'
                    pwd

                    echo ''
                    echo 'Files in /app:'
                    ls -lah

                    echo ''
                    echo 'Recursive listing:'
                    find . -maxdepth 2
                "
                '''
            }
        }

        stage('Black Formatting Check') {
            steps {
                sh '''
                docker run --rm \
                -v "$PWD/application":/app \
                -w /app \
                python:3.12-slim \
                sh -c "
                    pip install -r requirements.txt &&
                    black --check .
                "
                '''
            }
        }

        stage('Flake8 Lint') {
            steps {
                sh '''
                docker run --rm \
                -v "$PWD/application":/app \
                -w /app \
                python:3.12-slim \
                sh -c "
                    pip install -r requirements.txt &&
                    flake8 .
                "
                '''
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh '''
                docker run --rm \
                -v "$PWD/application":/app \
                -w /app \
                python:3.12-slim \
                sh -c "
                    pip install -r requirements.txt &&
                    pytest -v
                "
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build -t ${IMAGE_NAME}:${IMAGE_TAG} application
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline Successful'
        }

        failure {
            echo 'Pipeline Failed'
        }

        always {
            cleanWs()
        }
    }
}